// Time Complexity : O(n)
// Space Complexity : O(n)

// Iterate through the array and push numbers to the stack
// When a operand occurs, calculate the value using the 2 values on the top of the stack and push the result back to stack
// Return the value in the stack in the end

class Solution {
    public int evalRPN(String[] tokens) {
        Stack<String> stack = new Stack<>();
        int result = 0;
        for(String token : tokens) {
            if(token.equals("+") || token.equals("-") || token.equals("*") || token.equals("/")) {
                int op1 = Integer.parseInt(stack.pop());
                int op2 = Integer.parseInt(stack.pop());
                if(token.equals("+")) 
                    result = op1 + op2;
                else if(token.equals("-")) 
                    result = op2 - op1;
                else if(token.equals("*")) 
                    result = op1 * op2;
                else 
                    result = op2 / op1;
                stack.push(String.valueOf(result));
            }
            else
                stack.push(token);
        }
        return Integer.parseInt(stack.pop());
    }
}